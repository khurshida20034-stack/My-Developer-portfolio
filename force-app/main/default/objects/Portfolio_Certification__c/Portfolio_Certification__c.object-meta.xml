<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Portfolio Certification</label>
    <pluralLabel>Portfolio Certifications</pluralLabel>
    <description>The Portfolio Certification object lists certifications and badges earned, with issuer, date and credential link. Commonly used for the Certifications section.</description>
    <nameField>
        <label>Certification Name</label>
        <type>Text</type>
    </nameField>
    <sharingModel>ReadWrite</sharingModel>
    <deploymentStatus>Deployed</deploymentStatus>
    <visibility>Public</visibility>
    <enableActivities>true</enableActivities>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
</CustomObject>
